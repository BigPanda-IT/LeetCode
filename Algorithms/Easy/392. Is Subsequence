/**
 * @param {string} s
 * @param {string} t
 * @return {boolean}
 */
var isSubsequence = function(s, t) {
    let i=0;
    let j=0;
    let news='';

    while (i<s.length && j<t.length) {
        if (s[i] === t[j]) {
            news+=s[i];
            i++;
            j++;
        }
        else {
            j++;
        }
    }

    if (news.length === s.length) {
        return true;
    }
    else {
        return false;
    }

};
