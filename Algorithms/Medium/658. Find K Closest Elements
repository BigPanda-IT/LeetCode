/**
 * @param {number[]} arr
 * @param {number} k
 * @param {number} x
 * @return {number[]}
 */
var findClosestElements = function(arr, k, x) {
    let leftPointer=0;
    let rigthPointer=arr.length-1;
    
    while (rigthPointer-leftPointer >= k) {
        if (Math.abs(arr[leftPointer] - x) <= Math.abs(arr[rigthPointer] - x)) {
            rigthPointer--;
        }
        else { leftPointer++;}
    }

    return arr.slice(leftPointer, rigthPointer+1);
};
